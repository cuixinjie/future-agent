use_default_settings: true

general:
  instance_name: Future Agent Local Search

server:
  secret_key: REPLACE_WITH_RANDOM_LOCAL_SECRET
  limiter: false
  public_instance: false
  image_proxy: false

search:
  formats:
    - html
    - json

outgoing:
  request_timeout: 5.0
  max_request_timeout: 10.0
