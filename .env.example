# Copy to .env; placeholders are not usable service credentials.
# chat and analysis/forecast/evaluation commands can contact the configured model.
# doctor is offline by default; doctor --live sends up to two real model requests.
LLM_PROVIDER=compatible
LLM_BASE_URL=https://your-provider.example/v1
LLM_MODEL=your-model
LLM_API_KEY=
LLM_STRUCTURED_MODE=text_json
LLM_CONNECT_TIMEOUT=10
LLM_OUTPUT_TOKENS=4000
MAX_LLM_CALLS=12
MAX_RUN_SECONDS=600
MAX_CONTEXT_CHARS=60000
MAX_TOTAL_TOKENS=1000000
# Search is independent; authorized chat/research requests contact this SearXNG instance.
# The instance must enable JSON output. Local endpoints are permitted only for this channel.
SEARCH_PROVIDER=searxng
# SEARCH_BASE_URL=http://127.0.0.1:8888
MAX_SEARCH_QUERIES=8
MAX_PAGES=16
DATA_DIR=./data
# Optional. When omitted the database is DATA_DIR/app.db; custom paths must remain inside DATA_DIR.
# DATABASE_URL=sqlite:///./data/app.db
